@model IEnumerable<ProjetApp.Models.Etudiant>
@{ ViewData["Title"] = "Étudiants"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-people text-primary me-2"></i>Étudiants</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Nouvel Étudiant
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="bi bi-hash me-1"></i>N° Étudiant</th>
                    <th><i class="bi bi-person me-1"></i>Nom</th>
                    <th><i class="bi bi-person me-1"></i>Prénom</th>
                    <th><i class="bi bi-envelope me-1"></i>Email</th>
                    <th><i class="bi bi-phone me-1"></i>Téléphone</th>
                    <th><i class="bi bi-clipboard-check me-1"></i>Inscriptions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@e.NumeroEtudiant</span></td>
                        <td>@e.Nom</td>
                        <td>@e.Prenom</td>
                        <td><a href="mailto:@e.Email">@e.Email</a></td>
                        <td>@e.Telephone</td>
                        <td>
                            <span class="badge bg-primary">@(e.Inscriptions?.Count ?? 0)</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
