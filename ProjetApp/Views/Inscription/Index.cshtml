@model IEnumerable<ProjetApp.Models.Inscription>
@{ ViewData["Title"] = "Inscriptions"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-clipboard-check text-primary me-2"></i>Inscriptions</h2>
        <small class="text-muted">Gestion via ADO.NET</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nouvelle Inscription
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="bi bi-person me-1"></i>Étudiant</th>
                    <th><i class="bi bi-book me-1"></i>Formation</th>
                    <th><i class="bi bi-calendar me-1"></i>Date d'inscription</th>
                    <th><i class="bi bi-info-circle me-1"></i>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td>
                            <i class="bi bi-person-circle text-primary me-1"></i>
                            @i.Etudiant?.Nom @i.Etudiant?.Prenom
                        </td>
                        <td>@i.Formation?.Titre</td>
                        <td>@i.DateInscription.ToShortDateString()</td>
                        <td>
                            <span class="badge @(i.Statut == "Confirmée" ? "bg-success" : i.Statut == "En attente" ? "bg-warning text-dark" : "bg-danger")">
                                @i.Statut
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@i.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
