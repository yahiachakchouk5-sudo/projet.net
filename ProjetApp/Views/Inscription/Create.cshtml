@model ProjetApp.Models.Inscription
@{ ViewData["Title"] = "Nouvelle Inscription"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Nouvelle Inscription</h5>
                <small class="opacity-75">Enregistrement via ADO.NET</small>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="EtudiantId" class="form-label fw-semibold"></label>
                        <select asp-for="EtudiantId" asp-items="ViewBag.EtudiantId" class="form-select">
                            <option value="">-- Sélectionner un étudiant --</option>
                        </select>
                        <span asp-validation-for="EtudiantId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FormationId" class="form-label fw-semibold"></label>
                        <select asp-for="FormationId" asp-items="ViewBag.FormationId" class="form-select">
                            <option value="">-- Sélectionner une formation --</option>
                        </select>
                        <span asp-validation-for="FormationId" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-2"></i>
                        La date et le statut seront définis automatiquement.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Inscrire
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
