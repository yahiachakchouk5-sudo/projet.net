@model ProjetApp.Models.LoginViewModel
@{ 
    ViewData["Title"] = "Connexion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion – ProjetApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1565C0, #0D47A1);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 420px;
        }
        .login-header {
            background: #1565C0;
            border-radius: 16px 16px 0 0;
            padding: 2rem;
            text-align: center;
            color: white;
        }
        .login-body {
            padding: 2rem;
            background: white;
            border-radius: 0 0 16px 16px;
        }
        .btn-login {
            background: #1565C0;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            width: 100%;
        }
        .btn-login:hover { background: #0D47A1; color: white; }
        .form-control {
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ddd;
        }
        .form-control:focus {
            border-color: #1565C0;
            box-shadow: 0 0 0 3px rgba(21,101,192,0.15);
        }
    </style>
</head>
<body>
    <div class="login-card">

        <!-- Header -->
        <div class="login-header">
            <i class="bi bi-mortarboard-fill" style="font-size: 3rem;"></i>
            <h3 class="mt-2 mb-0 fw-bold">ProjetApp</h3>
            <p class="mb-0 opacity-75">Espace Administration</p>
        </div>

        <!-- Body -->
        <div class="login-body">
            <h5 class="text-center mb-4 text-muted">Connectez-vous à votre compte</h5>

            <form asp-action="Login" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">
                        <i class="bi bi-envelope me-1"></i>Email
                    </label>
                    <input asp-for="Email" class="form-control"
                           placeholder="admin@projetapp.tn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Mot de passe -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">
                        <i class="bi bi-lock me-1"></i>Mot de passe
                    </label>
                    <input asp-for="Password" class="form-control"
                           placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Se souvenir -->
                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label text-muted">
                        Se souvenir de moi
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                </button>
            </form>

           
            
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>